# Azure DevOps (obligatorio)
AZDO_ORG_URL=https://dev.azure.com/arsprimera
AZDO_PROJECT=Proyectos 2026
AZDO_PAT=
AZDO_API_VERSION=7.1

# IA: la clave define el proveedor. PROVEEDOR_IA es opcional (gemini | anthropic)
# y solo hace falta si desea forzarlo en el servidor.
PROVEEDOR_IA=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Puerto local de la aplicación (no uses el 3000 del ecosistema)
PORT_AMBIGUEDADES=3300
